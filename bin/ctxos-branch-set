#!/bin/bash

# ctxos:summary=Set the branch for CtxOS's git repository.
# ctxos:args=<master|rc|dev>

if (($# == 0)); then
  echo "Usage: ctxos-branch-set [master|rc|dev]"
  exit 1
else
  branch="$1"
fi

if [[ $branch != "master" && $branch != "rc" && $branch != "dev" ]]; then
  echo "Error: Invalid branch '$branch'. Must be one of: master, rc, dev"
  exit 1
fi

git -C $CTXOS_PATH switch $branch
