#!/bin/bash

# ctxos:summary=Set the CtxOS channel, which dictates what git branch and package repository is used.
# ctxos:args=<stable|rc|edge|dev>
# ctxos:requires-sudo=true

if (($# == 0)); then
  echo "Usage: ctxos-channel-set [stable|rc|edge|dev]"
  exit 1
else
  channel="$1"
fi

case "$channel" in
"stable") ctxos-branch-set "master" && ctxos-refresh-pacman "stable" ;;
"rc") ctxos-branch-set "rc" && ctxos-refresh-pacman "rc" ;;
"edge") ctxos-branch-set "master" && ctxos-refresh-pacman "edge" ;;
"dev") ctxos-branch-set "dev" && ctxos-refresh-pacman "edge" ;;
*) echo "Unknown channel: $channel"; exit 1; ;;
esac

ctxos-update -y
