#!/bin/bash

# Link all the key config files to ctxos's internal versions for quicker testing
ln -nsf ~/.local/share/ctxos/config/hypr/hyprland.conf ~/.config/hypr/
ln -nsf ~/.local/share/ctxos/config/hypr/hypridle.conf ~/.config/hypr/
ln -nsf ~/.local/share/ctxos/config/waybar/config ~/.config/waybar/
ln -nsf ~/.local/share/ctxos/config/wofi/config ~/.config/wofi/
