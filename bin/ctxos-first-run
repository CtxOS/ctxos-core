#!/bin/bash

# ctxos:summary=Finish the installation of CtxOS with items that can only be done after logging in.
# ctxos:requires-sudo=true

set -e

FIRST_RUN_MODE=~/.local/state/ctxos/first-run.mode

if [[ -f $FIRST_RUN_MODE ]]; then
  rm -f "$FIRST_RUN_MODE"

  bash "$CTXOS_PATH/install/first-run/battery-monitor.sh"
  bash "$CTXOS_PATH/install/first-run/recover-internal-monitor.sh"
  bash "$CTXOS_PATH/install/first-run/cleanup-reboot-sudoers.sh"
  bash "$CTXOS_PATH/install/first-run/firewall.sh"
  bash "$CTXOS_PATH/install/first-run/dns-resolver.sh"
  bash "$CTXOS_PATH/install/first-run/gnome-theme.sh"
  bash "$CTXOS_PATH/install/first-run/swayosd.sh"
  bash "$CTXOS_PATH/install/first-run/gtk-primary-paste.sh"
  bash "$CTXOS_PATH/install/first-run/text-scaling.sh"
  bash "$CTXOS_PATH/install/first-run/elephant.sh"
  ctxos-hook-install post-update "$CTXOS_PATH/install/first-run/install-voxtype.hook"
  sudo rm -f /etc/sudoers.d/first-run

  bash "$CTXOS_PATH/install/first-run/welcome.sh"
  bash "$CTXOS_PATH/install/first-run/wifi.sh"
fi
