#!/bin/bash

# ctxos:summary=Install Heroic Games Launcher (Epic, GOG, Amazon Prime Gaming) with graphics drivers.
# ctxos:requires-sudo=true

set -e

echo "Installing Heroic Games Launcher..."
ctxos-pkg-add heroic-games-launcher-bin
ctxos-install-gaming-gpu-lib32

setsid gtk-launch heroic >/dev/null 2>&1 &
