#!/bin/bash

# ctxos:summary=Install Steam and graphics drivers selected for this system
# ctxos:requires-sudo=true

set -e

echo "Installing Steam..."
ctxos-pkg-add steam
ctxos-install-gaming-gpu-lib32

echo ""
echo "Steam will start automatically now. This might take a while..."

setsid gtk-launch steam >/dev/null 2>&1 &
