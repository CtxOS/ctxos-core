#!/bin/bash

# ctxos:summary=Prompt for text input with Walker
# ctxos:group=menu
# ctxos:name=input
# ctxos:args=prompt [walker args...]
# ctxos:examples=ctxos menu input Reminder|ctxos-menu-input "Reminder in minutes" --width 400

set -euo pipefail

prompt="${1:-Input}"
if (( $# > 0 )); then
  shift
fi

ctxos-launch-walker --dmenu --inputonly --width 295 --minheight 1 --maxheight 1 -p "$prompt…" "$@" 2>/dev/null
