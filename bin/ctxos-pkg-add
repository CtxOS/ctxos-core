#!/bin/bash

# ctxos:summary=Install packages if they are missing
# ctxos:args=<packages...>
# ctxos:requires-sudo=true

if ctxos-pkg-missing "$@"; then
  sudo apt-get update && sudo apt-get install -y --no-install-recommends "$@" || exit 1
fi

for pkg in "$@"; do
  # Secondary check to handle states where apt doesn't actually register
  if ! dpkg -s "$pkg" &>/dev/null; then
    echo -e "\033[31mError: Package '$pkg' did not install\033[0m" >&2
    exit 1
  fi
done

exit 0