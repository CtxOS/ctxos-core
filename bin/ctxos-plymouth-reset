#!/bin/bash

# ctxos:summary=Restore the default CtxOS Plymouth boot theme and SDDM login screen
# ctxos:requires-sudo=true

theme_dir="/usr/share/plymouth/themes/ctxos"

sudo find ~/.local/share/ctxos/default/plymouth -maxdepth 1 -type f -exec cp -t "$theme_dir/" {} +
sudo plymouth-set-default-theme ctxos

if ctxos-cmd-present limine-mkinitcpio; then
  sudo limine-mkinitcpio
else
  sudo mkinitcpio -P
fi

ctxos-refresh-sddm
