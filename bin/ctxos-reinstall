#!/bin/bash

# ctxos:summary=Reinstall CtxOS packages and reset default configs
# ctxos:requires-sudo=true

set -e

# Attempt to reinstall all default CtxOS packages and reset all the default configs.

echo -e "This will reinstall all the default CtxOS packages and reset all default configs.\nWarning: All user changes to configs will be lost.\n"

if gum confirm "Are you sure you want to reinstall and lose all config changes?"; then
  ctxos-reinstall-git
  ctxos-reinstall-pkgs
  ctxos-reinstall-configs

  gum confirm "System has been reinstalled. Reboot?" && ctxos-system-reboot
fi
