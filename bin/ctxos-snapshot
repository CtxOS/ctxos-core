#!/bin/bash

TIMESTAMP=$(date +%Y%m%d_%H%M%S)
BACKUP_DIR="$HOME/.local/share/ctxos/backups/$TIMESTAMP"
mkdir -p "$BACKUP_DIR"
cp -r ~/.config/hypr "$BACKUP_DIR/" 2>/dev/null
cp -r ~/.config/alacritty "$BACKUP_DIR/" 2>/dev/null
cp -r ~/.config/waybar "$BACKUP_DIR/" 2>/dev/null
cp -r ~/.config/wofi "$BACKUP_DIR/" 2>/dev/null
cp -r ~/.config/nvim "$BACKUP_DIR/" 2>/dev/null
echo "Snapshot saved to $BACKUP_DIR"

