#!/bin/bash

# ctxos:summary=Display brightness level using SwayOSD on the current monitor.
# ctxos:args=<0-100>
# ctxos:examples=ctxos swayosd brightness 0 | ctxos swayosd brightness 50 | ctxos swayosd brightness 100

percent="$1"

progress="$(awk -v p="$percent" 'BEGIN{printf "%.2f", p/100}')"
[[ $progress == "0.00" ]] && progress="0.01"

ctxos-swayosd-client \
  --custom-icon display-brightness-symbolic \
  --custom-progress "$progress" \
  --custom-progress-text "${percent}%"
