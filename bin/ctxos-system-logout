#!/bin/bash

# ctxos:summary=Log out after closing application windows
# ctxos:examples=ctxos logout | ctxos system logout
# ctxos:aliases=ctxos logout

nohup bash -c "sleep 2 && uwsm stop" >/dev/null 2>&1 &

# Now close all windows
ctxos-hyprland-window-close-all
sleep 1 # Allow apps like Chrome to shutdown correctly
