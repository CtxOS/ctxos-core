#!/bin/bash
CURRENT_BG="$HOME/.config/ctxos/current/background"
BG_DIR="$(readlink "$(dirname "$CURRENT_BG")")"
BACKGROUNDS=($(find "$BG_DIR" -type f \( -name "*.jpg" -o -name "*.png" \) | sort))
TOTAL=${#BACKGROUNDS[@]}
if [[ $TOTAL -eq 0 ]]; then echo "No backgrounds found"; exit 1; fi
CURRENT=$(readlink "$CURRENT_BG" 2>/dev/null || echo "${BACKGROUNDS[0]}")
INDEX=0
for i in "${!BACKGROUNDS[@]}"; do
  [[ "${BACKGROUNDS[$i]}" == "$CURRENT" ]] && INDEX=$i && break
done
NEXT=$(( (INDEX + 1) % TOTAL ))
ln -nsf "${BACKGROUNDS[$NEXT]}" "$CURRENT_BG"
pkill -x swaybg
setsid swaybg -i "${BACKGROUNDS[$NEXT]}" -m fill &
notify-send "Background" "Changed to $(basename "${BACKGROUNDS[$NEXT]}")"
