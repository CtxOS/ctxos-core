#!/bin/bash

THEME="$1"
if [[ -z "$THEME" ]]; then
  echo "Usage: ctxos-theme-install <theme-name>"
  exit 1
fi
THEME_DIR="$HOME/.local/share/ctxos/themes/$THEME"
if [[ ! -d "$THEME_DIR" ]]; then
  echo "Theme not found: $THEME"
  exit 1
fi
ln -nsf "$THEME_DIR" "$HOME/.config/ctxos/current/theme"
notify-send "Theme" "Installed $THEME"

