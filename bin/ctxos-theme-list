#!/bin/bash

# ctxos:summary=List available themes
# ctxos:examples=ctxos theme list | ctxos theme set "Tokyo Night"

{
  find ~/.config/ctxos/themes/ -mindepth 1 -maxdepth 1 \( -type d -o -type l \) -printf '%f\n'
  find "$CTXOS_PATH/themes/" -mindepth 1 -maxdepth 1 -type d -printf '%f\n'
} | sort -u | while read -r name; do
  echo "$name" | sed -E 's/(^|-)([a-z])/\1\u\2/g; s/-/ /g'
done
