#!/bin/bash

# ctxos:summary=Apply an CtxOS theme
# ctxos:args=<theme-name>
# ctxos:examples=ctxos theme list | ctxos theme set "Tokyo Night"

if [[ -z $1 ]]; then
  echo "Usage: ctxos-theme-set <theme-name>"
  exit 1
fi

CURRENT_THEME_PATH="$HOME/.config/ctxos/current/theme"
NEXT_THEME_PATH="$HOME/.config/ctxos/current/next-theme"
USER_THEMES_PATH="$HOME/.config/ctxos/themes"
CTXOS_THEMES_PATH="$CTXOS_PATH/themes"

THEME_NAME=$(echo "$1" | sed -E 's/<[^>]+>//g' | tr '[:upper:]' '[:lower:]' | tr ' ' '-')

if [[ ! -d $CTXOS_THEMES_PATH/$THEME_NAME ]] && [[ ! -d $USER_THEMES_PATH/$THEME_NAME ]]; then
  echo "Theme '$THEME_NAME' does not exist"
  exit 1
fi

# Setup clean next theme directory (for atomic theme config swapping)
rm -rf "$NEXT_THEME_PATH"
mkdir -p "$NEXT_THEME_PATH"

# Copy official theme first, then overlay user customizations on top
cp -r "$CTXOS_THEMES_PATH/$THEME_NAME/"* "$NEXT_THEME_PATH/" 2>/dev/null
cp -r "$USER_THEMES_PATH/$THEME_NAME/"* "$NEXT_THEME_PATH/" 2>/dev/null

# Generate colors.toml from alacritty.toml if theme is missing colors.toml
if [[ ! -f $NEXT_THEME_PATH/colors.toml && -f $NEXT_THEME_PATH/alacritty.toml ]]; then
  ctxos-theme-colors-from-alacritty "$NEXT_THEME_PATH"
fi

# Generate dynamic configs
ctxos-theme-set-templates

# Swap next theme in as current
rm -rf "$CURRENT_THEME_PATH"
mv "$NEXT_THEME_PATH" "$CURRENT_THEME_PATH"

# Store theme name for reference
echo "$THEME_NAME" >"$HOME/.config/ctxos/current/theme.name"

# Change background with theme
if [[ $CTXOS_THEME_SKIP_BACKGROUND != "1" ]]; then
  ctxos-theme-bg-next
fi

# Restart components to apply new theme
if pgrep -x waybar >/dev/null; then
  ctxos-restart-waybar
fi
ctxos-restart-swayosd
ctxos-restart-terminal
ctxos-restart-hyprctl
ctxos-restart-btop
ctxos-restart-opencode
ctxos-restart-mako
ctxos-restart-helix

# Change app-specific themes
ctxos-theme-set-foot
ctxos-theme-set-gnome
ctxos-theme-set-browser
ctxos-theme-set-vscode
ctxos-theme-set-obsidian
ctxos-theme-set-keyboard

# Call hook on theme set
ctxos-hook theme-set "$THEME_NAME" >/dev/null
