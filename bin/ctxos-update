#!/bin/bash

# ctxos:summary=Update CtxOS and system packages
# ctxos:args=[-y]
# ctxos:examples=ctxos update | ctxos update -y
# ctxos:requires-sudo=true

set -e

# Run the update inside a PTY so pacman/yay keep showing download progress
# while still logging the full session for later analysis.
if [[ -z $CTXOS_UPDATE_LOGGED ]]; then
  script_command=$(printf '%q ' "$0" "$@")
  exec env CTXOS_UPDATE_LOGGED=1 script -qefc "$script_command" "/tmp/ctxos-update.log"
fi

trap 'echo ""; echo -e "\033[0;31mSomething went wrong during the update!\n\nPlease review the output above carefully, correct the error, and retry the update.\n\nIf you need assistance, get help from the community at https://ctxos.org/discord\033[0m"' ERR

if [[ $1 == "-y" ]] || ctxos-update-confirm; then
  ctxos-snapshot create || (($? == 127))
  ctxos-update-git
  ctxos-update-perform
fi
