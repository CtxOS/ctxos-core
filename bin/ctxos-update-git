#!/bin/bash

# ctxos:summary=Pull the latest CtxOS git changes

set -e

echo -e "\e[32mUpdate CtxOS\e[0m"

ctxos-update-time

# Suppress Hyprland config errors while git updates default config files mid-pull
hyprctl keyword debug:suppress_errors true &>/dev/null || true

git -C $CTXOS_PATH pull --autostash
git -C $CTXOS_PATH --no-pager diff --check || git -C $CTXOS_PATH reset --merge

hyprctl reload &>/dev/null || true
