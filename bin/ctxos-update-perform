#!/bin/bash

# ctxos:summary=Run the full CtxOS update pipeline
# ctxos:requires-sudo=true

set -e

# Ensure screensaver/sleep doesn't set in during updates
hyprctl dispatch tagwindow +noidle &>/dev/null || true

# Perform all update steps
ctxos-update-keyring
ctxos-update-available-reset
ctxos-update-system-pkgs
ctxos-migrate
ctxos-update-aur-pkgs
ctxos-update-orphan-pkgs
ctxos-hook post-update

ctxos-update-analyze-logs

ctxos-update-restart

# Re-enable screensaver/sleep after updates
hyprctl dispatch tagwindow -- -noidle &>/dev/null || true
